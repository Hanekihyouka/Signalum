	quest.07084582F9562740.title: "&c染&e色&a和&b颜&3料"
	quest.0759CA52EECF3B49.quest_desc: [
		"作为结构一部分运作时会模拟锄，对下方土类方块执行使用锄的操作，如将泥土、草方块、土径变为耕地；将砂土、缠根泥土变为泥土等。"
		"会破坏前方的雪、火把、铁轨等无碰撞方块。"
		""
		"会击飞前方的实体。"
	]
	quest.0759CA52EECF3B49.title: "&6动力犁"
	quest.075D8C74F476E0EB.quest_desc: ["模拟玩家点击，十分消耗计算资源，运行速度过快时会非常卡。"]
	quest.078C5B50CDC174CB.quest_desc: ["用于构建旋转结构，整个结构将绕它旋转。"]
	quest.078C5B50CDC174CB.title: "&a动力轴承"
	quest.0795C1185F210595.quest_desc: [
		"&d焦炉&r能将煤炭转化为&a焦煤&r和&7杂酚油&r。"
		"&a焦煤&r可以作为高炉燃料来炼钢，而&a杂酚油&r用于许多配方。"
		"&d焦炉&r的速度十分缓慢，你可能需要不止一座，将&d焦炉砖&r摆成一个3x3x3的正方体，然后使用&b工程师锤&r右击任意一面中间的方块来激活它。"
		"&7多个焦炉间不能共用方块。&r"
	]
	quest.0795C1185F210595.title: "焦炉"
	quest.081DC030A0546549.quest_desc: [
		"粉碎一些植物来获取&a生物燃料&r，西瓜片是不错的选择。"
		"生物燃料可以用来生产&6乙烯&r，供给燃气发电。"
		"或者，你需要它来制作 &3HDPE&r."
	]
	quest.081DC030A0546549.title: "&4粉碎&2植物&f得到&2生物燃料"
	quest.083D458032F0325C.quest_desc: [""]
	quest.087F6C09CB5B2D1A.quest_desc: [
