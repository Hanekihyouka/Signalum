	quest.0A8E05C077F047D7.quest_subtitle: "手撸石头！"
	quest.0AA9EF3981E9BA37.quest_desc: [
		"非常适合用作能量存储。"
		"&a&l基础&r：储存1.6mFE。"
		"&c&l高级&r：储存6.4mFE。"
		"&b&l精英&r：储存25.6mFE。"
		"&d&l终极&r：储存102.4mFE。"
		""
		"如果还不够，你需要&6输导矩阵&r。"
	]
	quest.0AA9EF3981E9BA37.title: "&a能量立方"
	quest.0ACC0092A8F722C6.quest_desc: [
		"&d线缆&r是&bIE&r传输能源的基本手段，"
		"放置两个相同等级的&d接线器&r，然后使用线缆右键连接它们。"
		"线缆会占据曲线空间，当中不能有方块遮挡。"
	]
	quest.0ACC0092A8F722C6.title: "&c线缆线圈"
	quest.0ACE573560A19309.quest_desc: [
