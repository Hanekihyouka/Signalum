	quest.21D7C0C4B2592BF8.quest_desc: ["当前方是特定方块、实体、玩家时，向后方发出红石信号。"]
	quest.21D8B88155648EA6.quest_desc: [
		"&bMEK·通用机械&r拥有一套完善的发电和加工处理体系。"
		"它的机器通常是最高效的。"
		"&6MekaSuit&r 是本包中最好用的护甲。"
		""
		"首先，你需要&d钢制机壳&r来制作大部分基础机器。"
	]
	quest.21D8B88155648EA6.title: "&b&l通用机械"
	quest.21F3379C904BFD50.quest_desc: [
		"消耗 FE 产生热量，在 gui 中输入数字来调节能耗。"
		"耗电越高，发热越高，最大耗电 40MFE/t."
