		""
		"它防爆。"
	]
	quest.0A4962728C98DAD9.title: "&e物品保险库"
	quest.0A7B0D0B81E138DE.quest_desc: [
		"手持&6右键&r打开，可以分类存放工具、食物、线材、杂物。"
		""
		"&6Shift右键&r可放置于地面。"
