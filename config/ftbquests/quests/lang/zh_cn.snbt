	quest.1F7DA060792D716A.quest_subtitle: "12FE/t"
	quest.1F7DA060792D716A.title: "搅拌机"
	quest.1F7DFA5AA65F2812.quest_desc: ["&b加速卡&f，根据升级的设备不同，要么会增加设备的操作速度，要么允许设备一次执行更多的操作。"]
	quest.1F7DFA5AA65F2812.quest_subtitle: "逮虾户"
