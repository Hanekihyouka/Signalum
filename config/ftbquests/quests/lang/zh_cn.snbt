	quest.063241B72BB3403E.title: "&8&l重型盾牌"
	quest.0650996C7818ADB5.quest_desc: [
		"&a主动模式&r添加任何易燃物就能产生能量。"
		""
		"发电量不多，如果你已经有无限&c熔岩&r了，不妨试试它的升级版本。"
